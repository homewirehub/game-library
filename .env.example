# --- Application ---
NODE_ENV=development
PORT=3001

# --- Database ---
# Use either sqlite or postgres
DB_TYPE=sqlite
# SQLite
DB_PATH=./gamelib.db
DB_SQLITE_DRIVER=better-sqlite3
# Postgres (optional alternative)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_NAME=gamelib
# DATABASE_URL=postgres://user:pass@localhost:5432/gamelib

# --- Security / CORS ---
# Comma-separated list of origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# JWT
JWT_SECRET=dev-only-please-change-me
JWT_EXPIRES_IN=7d

# --- Storage ---
STORAGE_PATH=./storage
MAX_FILE_SIZE=5368709120
ALLOWED_FILE_TYPES=.zip,.rar,.7z,.iso,.exe

# --- Rate limit / Redis (optional) ---
# RATE_LIMIT_REDIS_ENABLED=true
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- Feature flags ---
ITCH_ENABLED=true
STEAM_ENABLED=true
