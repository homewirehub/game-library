# =============================================================================
# GAME LIBRARY - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and customize the values for your environment
# 
# 🔴 IMPORTANT: Never commit your actual .env file to version control!
# 🔴 Generate secure secrets for production environments!
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Choose either 'sqlite' (for development) or 'postgres' (for production)
DB_TYPE=sqlite

# SQLite Configuration (for development)
DB_PATH=./gamelib.db

# PostgreSQL Configuration (for production)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=gamelib_user
# DB_PASSWORD=your_secure_password
# DB_NAME=gamelib

# 🔴 SECURITY: Never set to 'true' in production! Use migrations instead.
DB_SYNCHRONIZE=false

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (for rate limiting)
# -----------------------------------------------------------------------------
# Option 1: Use Redis URL (recommended)
# REDIS_URL=redis://localhost:6379

# Option 2: Individual Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Enable Redis-backed rate limiting (recommended for production)
RATE_LIMIT_REDIS_ENABLED=true

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# 🔴 CRITICAL: Change this for production! Minimum 64 characters recommended.
JWT_SECRET=your-super-secure-jwt-secret-key-min-32-chars-for-development-only-change-for-production
JWT_EXPIRES_IN=24h

# -----------------------------------------------------------------------------
# FILE UPLOAD SETTINGS
# -----------------------------------------------------------------------------
UPLOAD_PATH=./storage/uploads
MAX_FILE_SIZE=1073741824
ALLOWED_FILE_TYPES=.zip,.rar,.7z,.tar.gz

# -----------------------------------------------------------------------------
# SECURITY SETTINGS
# -----------------------------------------------------------------------------
# CORS origins (use specific URLs in production, never '*')
CORS_ORIGIN=http://localhost:5173

# BCrypt rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# EXTERNAL API KEYS (Optional - for metadata fetching)
# -----------------------------------------------------------------------------
# Steam API Key (get from: https://steamcommunity.com/dev/apikey)
# STEAM_API_KEY=your_steam_api_key

# IGDB API (get from: https://api.igdb.com/signup)
IGDB_CLIENT_ID=your_igdb_client_id_here
IGDB_CLIENT_SECRET=your_igdb_client_secret_here

# RAWG API Key (get from: https://rawg.io/apidocs)
RAWG_API_KEY=your_rawg_api_key_here

# -----------------------------------------------------------------------------
# INSTALLATION & ADMIN
# -----------------------------------------------------------------------------
# Require installation wizard on first run
REQUIRE_INSTALLATION=true

# Default admin credentials (set during installation)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=secure_password_min_8_chars

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Log levels: error, warn, info, debug
LOG_LEVEL=info

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
# For production deployment, ensure:
#
# 1. ✅ Set NODE_ENV=production
# 2. ✅ Use PostgreSQL (DB_TYPE=postgres)
# 3. ✅ Generate a secure 64+ character JWT_SECRET
# 4. ✅ Set specific CORS_ORIGIN (never '*')
# 5. ✅ Use Redis for rate limiting
# 6. ✅ Set DB_SYNCHRONIZE=false (use migrations)
# 7. ✅ Configure strong admin password
# 8. ✅ Use environment-specific API keys
# 9. ✅ Configure proper SSL/TLS
# 10. ✅ Set appropriate LOG_LEVEL (warn or error)
#
# Security checklist:
# - [ ] JWT secret is cryptographically random and 64+ chars
# - [ ] Database password is strong and unique
# - [ ] Redis password is set (if exposed)
# - [ ] CORS is restricted to your domain(s)
# - [ ] File upload limits are appropriate
# - [ ] All secrets are in environment variables, not code
# =============================================================================
